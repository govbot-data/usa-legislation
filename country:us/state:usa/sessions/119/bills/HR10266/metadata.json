  "legislative_session": "119",
  "identifier": "HR 10266",
  "title": "No Elite Athletes Using X-pro status to ensure Prioritizing Recruitment Of Student-athletes (NEAUX PROS) Act",
  "from_organization": "~{\"classification\": \"lower\"}",
  "classification": [
    "bill"
  ],
  "subject": [],
  "abstracts": [],
  "other_titles": [
    {
      "note": "",
      "title": "To amend the Higher Education Act of 1965 to condition institutional eligibility for participation in programs under title IV of that Act on an institution's not permitting certain professional athletes to compete in intercollegiate athletics competition in the sport in which they hold a professional sports contract, to establish criminal penalties for athletics officials who knowingly recruit or sign such athletes to compete in violation of that condition, and for other purposes."
    }
  ],
