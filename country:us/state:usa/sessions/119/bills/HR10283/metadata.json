  ],
  "subject": [],
  "abstracts": [],
  "other_titles": [
    {
      "note": "",
      "title": "To provide that, if an individual is expelled from Congress or resigns from Congress in certain cases involving misconduct, any Member service previously rendered by that individual shall be noncreditable for purposes of determining eligibility for an annuity under the Civil Service Retirement System or the Federal Employees Retirement System, and for other purposes."
    }
  ],
