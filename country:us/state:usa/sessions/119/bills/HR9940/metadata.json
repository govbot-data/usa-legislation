  "other_titles": [
    {
      "note": "",
      "title": "To amend title XIX of the Social Security Act to provide a temporary higher Federal medical assistance percentage for Federal expenditures under the Medicaid program that are associated with the cost of compliance with certain Federal regulations with respect to services furnished in certain intermediate care facilities or home and community-based services furnished to individuals with intellectual and developmental disabilities."
    }
  ],
