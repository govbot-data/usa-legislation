<form display="yes">
<congress display="yes">119th CONGRESS</congress><session display="yes">2d Session</session><legis-num display="yes">S. 528</legis-num><current-chamber display="no">IN THE SENATE OF THE UNITED STATES</current-chamber><legis-type display="yes">AN ACT</legis-type><official-title display="yes">To reauthorize the Great Lakes Restoration Initiative, and for other purposes.</official-title></form><legis-body style="OLC" display-enacting-clause="yes-display-enacting-clause"><section commented="no" display-inline="no-display-inline" section-type="section-one" id="S1"><enum>1.</enum><header display-inline="yes-display-inline">Short title</header><text display-inline="no-display-inline">This Act may be cited as the <quote><short-title>Great Lakes Restoration Initiative Act of 2026</short-title></quote> or the <quote><short-title>GLRI Act of 2026</short-title></quote>.</text></section><section id="id3389378e-2acd-4761-a887-7aa889deca2f" changed="not-changed"><enum>2.</enum><header>Great Lakes Restoration Initiative</header><text display-inline="no-display-inline">Section 118(c)(7)(J) of the Federal Water Pollution Control Act (<external-xref legal-doc="usc" parsable-cite="usc/33/1268">33 U.S.C. 1268(c)(7)(J)</external-xref>) is amended by striking clause (i) and inserting the following:</text><quoted-block id="id3fce8026-73f0-44af-be77-4d3ef0d8a7ec" style="OLC" act-name="" changed="not-changed"><clause id="id1cd61f8a-eb94-403e-a9c4-142ae6f0ca17" changed="not-changed"><enum>(i)</enum><header>In general</header><text>There is authorized to be appropriated to carry out this paragraph $475,000,000 for each of fiscal years 2027 through 2030.</text></clause><after-quoted-block>.</after-quoted-block></quoted-block></section></legis-body><attestation><attestation-group><attestation-date date="20260929" chamber="Senate">Passed the Senate September 29, 2026.</attestation-date><attestor display="no"></attestor><role>Secretary</role></attestation-group></attestation><endorsement display="yes"></endorsement></bill> 

